# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets no Streamlit Cloud.
# Sem DATABASE_URL, o app usa um arquivo SQLite local (rumo_crm.db).
# No Streamlit Cloud use PostgreSQL (Neon ou Supabase têm plano gratuito), senão os dados somem a cada reinício.
DATABASE_URL = "postgresql://usuario:senha@host:5432/banco?sslmode=require"
